# Copy to .env (never commit .env). Nothing here is a real secret.
MOCK=0                      # 1 = every endpoint served from fixtures; MOCK_TWIN / MOCK_SOLVER / MOCK_WHATIF / MOCK_SIM / MOCK_AGENTS / MOCK_COPILOT=1 mocks one group
SEED=1234
DB_PATH=data/aerotwin.db
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=          # leave empty to run agents in scripted mode; put the key here, locally, never in chat/commits
